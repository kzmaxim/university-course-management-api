@model IReadOnlyList<UniversityCourseManagementClient.Models.CourseListItem>
@{
    ViewData["Title"] = "Courses";
}

<h1 class="mb-3">Courses</h1>

@if (!string.IsNullOrWhiteSpace(ViewBag.Error as string))
{
    <div class="alert alert-danger" role="alert">@ViewBag.Error</div>
}

@if (Model.Count == 0)
{
    <p>No courses available.</p>
}
else
{
    <table class="table table-striped">
        <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Credits</th>
            <th>Teacher</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var course in Model)
        {
            <tr>
                <td>@course.Id</td>
                <td>@course.Name</td>
                <td>@course.Credits</td>
                <td>@course.TeacherName</td>
                <td><a asp-action="Details" asp-route-id="@course.Id">Details</a></td>
            </tr>
        }
        </tbody>
    </table>
}
