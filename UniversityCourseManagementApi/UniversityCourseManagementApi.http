@UniversityCourseManagementApi_HostAddress = http://localhost:5278

### Students
GET {{UniversityCourseManagementApi_HostAddress}}/api/students
Accept: application/json

###
GET {{UniversityCourseManagementApi_HostAddress}}/api/students/1
Accept: application/json

###
POST {{UniversityCourseManagementApi_HostAddress}}/api/students
Content-Type: application/json

{
  "firstName": "Nurlan",
  "lastName": "Bekov",
  "email": "nurlan.bekov@student.kz",
  "birthDate": "2004-05-10"
}

###
PUT {{UniversityCourseManagementApi_HostAddress}}/api/students/1
Content-Type: application/json

{
  "firstName": "Alex",
  "lastName": "Smith",
  "email": "alex.smith@student.kz",
  "birthDate": "2004-03-12"
}

###
DELETE {{UniversityCourseManagementApi_HostAddress}}/api/students/3

